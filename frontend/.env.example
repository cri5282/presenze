# Configurazione Firebase (valori pubblici del client web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=iltuo-progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iltuo-progetto
VITE_FIREBASE_STORAGE_BUCKET=iltuo-progetto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Client OAuth Web per Google Calendar (solo amministratore)
VITE_GOOGLE_CLIENT_ID=

# GitHub Pages project site: /presenze/ — per un dominio custom usare /
VITE_BASE_PATH=/

# Dati mostrati nella pagina privacy
VITE_DATA_CONTROLLER=
VITE_PRIVACY_CONTACT_EMAIL=

# Sviluppo locale con Firebase Emulator Suite
# VITE_USE_FIREBASE_EMULATORS=true
