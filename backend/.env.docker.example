# ===== Configurazione per Docker =====
# Copia questo file in backend/.env e compila i valori.
# Per Docker locale l'app è su http://localhost:8080.

# Genera una chiave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-questa-chiave-con-una-casuale-lunga

FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./data/presenze.db

# ===== Google Cloud =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve coincidere con un URI autorizzato nella console Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Facoltativo ma consigliato: solo queste email possono accedere (separate da virgola).
ALLOWED_EMAILS=
# Facoltativo: consenti tutti gli account dei domini indicati (separati da virgola).
# Esempio per una classe: ALLOWED_EMAIL_DOMAINS=itsolivetti.it
ALLOWED_EMAIL_DOMAINS=

# ===== Sincronizzazione =====
SYNC_INTERVAL_MINUTES=15
# Calendari selezionati per i nuovi utenti (separati da virgola).
# Per una classe puoi mettere primary e l'ID del calendario condiviso.
DEFAULT_CALENDAR_IDS=primary
INITIAL_SYNC_DAYS_BACK=180
INITIAL_SYNC_DAYS_FORWARD=90

# ===== Privacy =====
# Dati mostrati nella pagina pubblica /privacy.
# Se vuoti, la pagina usa un'intestazione generica.
DATA_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
