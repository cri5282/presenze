# ===== Generali =====
# Genera una chiave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-questa-chiave-con-una-casuale-lunga

# URL pubblico del frontend (dove viene rimandato l'utente dopo il login)
FRONTEND_URL=http://localhost:5173

# Cookie di sessione: metti true solo quando servi l'app in HTTPS
COOKIE_SECURE=false

# Database (SQLite di default, il file viene creato automaticamente)
DATABASE_URL=sqlite:///./data/presenze.db

# ===== Google Cloud =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve corrispondere ESATTAMENTE a un URI autorizzato nella console Google Cloud.
# Sviluppo:  http://localhost:8000/api/auth/google/callback
# Docker:    http://localhost:8080/api/auth/google/callback
# Produzione: https://tuo-dominio.example/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Facoltativo ma consigliato: consenti l'accesso solo a queste email (separate da virgola).
# Vuoto = chiunque abbia accesso al client OAuth può creare un account sul tuo server.
ALLOWED_EMAILS=
# Facoltativo: consenti tutti gli account dei domini indicati (separati da virgola).
# Esempio per una classe: ALLOWED_EMAIL_DOMAINS=itsolivetti.it
ALLOWED_EMAIL_DOMAINS=

# ===== Sincronizzazione =====
# Ogni quanti minuti il server riallinea i calendari
SYNC_INTERVAL_MINUTES=15
# Calendari selezionati per i nuovi utenti (separati da virgola).
# Per una classe puoi mettere primary e l'ID del calendario condiviso.
DEFAULT_CALENDAR_IDS=primary
# Finestra della prima sincronizzazione (giorni indietro / avanti)
INITIAL_SYNC_DAYS_BACK=180
INITIAL_SYNC_DAYS_FORWARD=90

# ===== Privacy =====
# Dati mostrati nella pagina pubblica /privacy.
# Se vuoti, la pagina usa un'intestazione generica.
DATA_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
